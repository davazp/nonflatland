// Everything lives in the universal cover: the Euclidean plane R².
//
// A space is the quotient of the plane by a group of isometries generated by
//
//   a(x, y) = (2L + f.x·x, f.y·y)
//   b(x, y) = (x, y + 2L)
//
// with fundamental domain D = [-L, L)². The "flip" f selects the space:
//
//   f = (+1, +1)  torus          a is a translation
//   f = (+1, -1)  Klein bottle   a is a glide reflection
//   f = (-1, -1)  pillowcase     a is a half-turn about (L, 0)
//
// The pillowcase group has fixed points: its quotient is a sphere that is
// flat except for four cone points of angle π, at (±L, 0) and (±L, L).
// The plane is the trivial group.
//
// Each pixel is mapped screen → world by `view` (the only thing that depends
// on the camera mode), then world → D by `reduce`. The pattern is a function
// on D, and the ship is tested against the few lifts of D that touch D.

struct Uniforms {
  view: mat3x3f,     // screen -> world
  shipInv: mat3x3f,  // world -> ship local frame
  resolution: vec2f,
  halfSize: f32,     // L
  space: u32,        // 0 plane, 1 torus, 2 klein, 3 pillowcase
  time: f32,
  thrust: f32,
  camera: u32,       // 0 fixed, 1 ship
  shipSize: f32,
};

@group(0) @binding(0) var<uniform> u: Uniforms;

const PI = 3.14159265;

@vertex
fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let p = vec2f(f32((i << 1u) & 2u), f32(i & 2u));
  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);
}

// ---------------------------------------------------------------------------
// Geometry of the space

fn flip() -> vec2f {
  switch u.space {
    case 2u: { return vec2f(1.0, -1.0); }
    case 3u: { return vec2f(-1.0, -1.0); }
    default: { return vec2f(1.0, 1.0); }
  }
}

// Map a point of the cover to its representative in D.
fn reduce(w: vec2f) -> vec2f {
  if (u.space == 0u) {
    return w;
  }
  let L = u.halfSize;
  var p = w;
  let n = floor((p.x + L) / (2.0 * L));
  p.x -= n * 2.0 * L;
  if ((i32(n) & 1) != 0) {
    p *= flip();
  }
  p.y -= floor((p.y + L) / (2.0 * L)) * 2.0 * L;
  return p;
}

// The group element mapping D onto the tile (i, j) of the cover.
fn deck(i: i32, j: i32, q: vec2f) -> vec2f {
  let L = u.halfSize;
  let f = select(vec2f(1.0), flip(), (i & 1) != 0);
  return 2.0 * L * vec2f(f32(i), f32(j)) + f * q;
}

// ---------------------------------------------------------------------------
// SDF helpers

fn sdBox(p: vec2f, c: vec2f, h: vec2f) -> f32 {
  let d = abs(p - c) - h;
  return length(max(d, vec2f(0.0))) + min(max(d.x, d.y), 0.0);
}

fn sdSegment(p: vec2f, a: vec2f, b: vec2f) -> f32 {
  let pa = p - a;
  let ba = b - a;
  let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
  return length(pa - ba * h);
}

fn sdTriangle(p: vec2f, p0: vec2f, p1: vec2f, p2: vec2f) -> f32 {
  let e0 = p1 - p0;
  let e1 = p2 - p1;
  let e2 = p0 - p2;
  let v0 = p - p0;
  let v1 = p - p1;
  let v2 = p - p2;
  let pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
  let pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
  let pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);
  let s = sign(e0.x * e2.y - e0.y * e2.x);
  let d = min(min(vec2f(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
                  vec2f(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))),
                  vec2f(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));
  return -sqrt(d.x) * sign(d.y);
}

fn fill(d: f32, pw: f32) -> f32 {
  return 1.0 - smoothstep(-pw, pw, d);
}

// ---------------------------------------------------------------------------
// Background: a pattern on D, continuous across the identifications except
// for deliberately chiral decorations that reveal the Klein flip.

fn gridDist(q: vec2f, spacing: f32) -> f32 {
  let g = abs(fract(q / spacing + 0.5) - 0.5) * spacing;
  return min(g.x, g.y);
}

// "^"-shaped chevrons along an axis; `a` runs along, `c` across.
fn chevrons(a: f32, c: f32, period: f32, h: f32) -> f32 {
  let s = a - (floor(a / period) + 0.5) * period;
  let d = abs(s + 0.8 * abs(c)) * 0.78;
  return max(d, abs(c) - h);
}

fn glyphF(p: vec2f) -> f32 {
  var d = sdBox(p, vec2f(-0.15, 0.0), vec2f(0.06, 0.30));
  d = min(d, sdBox(p, vec2f(0.03, 0.24), vec2f(0.18, 0.06)));
  d = min(d, sdBox(p, vec2f(-0.01, 0.01), vec2f(0.14, 0.05)));
  return d;
}

fn pattern(q: vec2f, pw: f32) -> vec3f {
  let L = u.halfSize;
  let k = PI / L;

  // Smooth background, periodic and even in y so it is well defined
  // on both the torus and the Klein bottle.
  var col = mix(vec3f(0.025, 0.03, 0.07), vec3f(0.08, 0.035, 0.11), 0.5 + 0.5 * cos(k * q.x));
  col += vec3f(0.0, 0.04, 0.06) * (0.5 + 0.5 * cos(k * q.y));

  // Grid
  let minor = gridDist(q, L / 8.0);
  let major = gridDist(q, L / 2.0);
  col = mix(col, vec3f(0.22, 0.25, 0.4), 0.35 * fill(minor - 0.25 * pw, pw));
  col = mix(col, vec3f(0.35, 0.4, 0.65), 0.6 * fill(major - 0.6 * pw, pw));

  // Origin frame: red +x, green +y
  let fx = sdSegment(q, vec2f(0.0), vec2f(0.22 * L, 0.0)) - 0.012 * L;
  let fy = sdSegment(q, vec2f(0.0), vec2f(0.0, 0.22 * L)) - 0.012 * L;
  col = mix(col, vec3f(0.95, 0.3, 0.3), fill(fx, pw));
  col = mix(col, vec3f(0.3, 0.9, 0.4), fill(fy, pw));
  col = mix(col, vec3f(0.9), fill(length(q) - 0.025 * L, pw));

  // A big asymmetric letter
  let fs = 0.55 * L;
  let dF = glyphF((q - vec2f(-0.5, 0.45) * L) / fs) * fs;
  col = mix(col, vec3f(1.0, 0.72, 0.25), fill(dF, pw));

  // Three dots of decreasing size, counter-clockwise
  let dc = vec2f(0.5, -0.45) * L;
  let r = 0.16 * L;
  var dd = length(q - dc - r * vec2f(0.0, 1.0)) - 0.07 * L;
  dd = min(dd, length(q - dc - r * vec2f(-0.866, -0.5)) - 0.05 * L);
  dd = min(dd, length(q - dc - r * vec2f(0.866, -0.5)) - 0.03 * L);
  col = mix(col, vec3f(0.55, 0.75, 1.0), fill(dd, pw));

  // Seams of D, with the classic gluing-diagram arrows
  if (u.space != 0u) {
    let edge = L - abs(q);
    let inset = 0.07 * L;
    let period = 0.25 * L;
    let h = 0.03 * L;
    let cyan = vec3f(0.3, 0.85, 0.95);
    var xSeamColor = cyan;
    if (u.space == 2u) {
      xSeamColor = vec3f(0.95, 0.35, 0.85);
    } else if (u.space == 3u) {
      xSeamColor = vec3f(0.95, 0.85, 0.3);
    }

    // Bottom/top edges: glued by b, arrows point +x on both.
    let cy = chevrons(q.x, edge.y - inset, period, h) - 0.25 * pw;
    col = mix(col, cyan, 0.8 * fill(cy, pw));
    col = mix(col, cyan, 0.5 * fill(edge.y - 0.8 * pw, pw));

    // Left/right edges. Torus and Klein bottle glue them to each other with
    // a, the Klein bottle reversing direction. The pillowcase folds each one
    // onto itself about its midpoint, so arrows point away from it.
    var along = q.y;
    if (u.space == 3u) {
      along = abs(q.y);
    } else if (q.x > 0.0) {
      along *= flip().y;
    }
    let cx = chevrons(along, edge.x - inset, period, h) - 0.25 * pw;
    col = mix(col, xSeamColor, 0.8 * fill(cx, pw));
    col = mix(col, xSeamColor, 0.5 * fill(edge.x - 0.8 * pw, pw));

    // Cone points of the pillowcase.
    if (u.space == 3u) {
      let aq = abs(q);
      let dc = min(length(aq - vec2f(L, 0.0)), length(aq - vec2f(L, L)));
      col = mix(col, xSeamColor, fill(abs(dc - 0.06 * L) - 0.008 * L, pw));
      col = mix(col, vec3f(1.0), fill(dc - 0.02 * L, pw));
    }
  }

  return col;
}

// ---------------------------------------------------------------------------
// Ship, in its local frame (units of shipSize, nose along +y).
// The two halves have different colours so a mirrored ship is visible.

fn ship(p: vec2f, pw: f32) -> vec4f {
  var res = vec4f(0.0);

  if (u.thrust > 0.0) {
    let flicker = 0.15 * sin(u.time * 47.0) + 0.1 * sin(u.time * 31.0);
    let len = (0.5 + flicker) * u.thrust + 0.2;
    let df = sdTriangle(p, vec2f(-0.28, -0.7), vec2f(0.0, -0.75 - len), vec2f(0.28, -0.7));
    let fc = mix(vec3f(1.0, 0.35, 0.05), vec3f(1.0, 0.9, 0.4), clamp(-df * 6.0, 0.0, 1.0));
    res = vec4f(fc, fill(df, pw));
  }

  var hull = sdTriangle(p, vec2f(0.0, 1.0), vec2f(-0.75, -0.85), vec2f(0.75, -0.85));
  hull = max(hull, -(length(p - vec2f(0.0, -1.15)) - 0.5));
  let side = select(vec3f(0.2, 0.8, 0.95), vec3f(1.0, 0.5, 0.15), p.x < 0.0);
  var hc = mix(side, vec3f(0.05), smoothstep(-0.12, -0.04, hull));
  hc = mix(hc, vec3f(0.95), fill(length(p - vec2f(0.0, 0.2)) - 0.15, pw));
  let a = fill(hull, pw);
  res = vec4f(mix(res.rgb, hc, a), max(res.a, a));
  return res;
}

// ---------------------------------------------------------------------------

@fragment
fn fs(@builtin(position) pos: vec4f) -> @location(0) vec4f {
  let halfRes = 0.5 * min(u.resolution.x, u.resolution.y);
  var s = (pos.xy - 0.5 * u.resolution) / halfRes;
  s.y = -s.y;

  let w = (u.view * vec3f(s, 1.0)).xy;
  let pw = length(u.view[0].xy) / halfRes;
  let q = reduce(w);

  var col = pattern(q, pw);

  // Ship: test the lifts of q in the neighbouring copies of D.
  let spw = pw / u.shipSize;
  let n = select(1, 0, u.space == 0u);
  for (var i = -n; i <= n; i++) {
    for (var j = -n; j <= n; j++) {
      let lp = (u.shipInv * vec3f(deck(i, j, q), 1.0)).xy / u.shipSize;
      let sc = ship(lp, spw);
      col = mix(col, sc.rgb, sc.a);
    }
  }

  // In the fixed camera, dim everything outside the fundamental domain.
  if (u.camera == 0u && u.space != 0u && any(abs(w) > vec2f(u.halfSize))) {
    col *= 0.4;
  }

  return vec4f(col, 1.0);
}
